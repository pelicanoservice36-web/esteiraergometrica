// Configuração do Worker que publica o site (Workers Builds, a cada push no main).
// Os arquivos estáticos vêm de dist/ (npm run build). O código em worker/ só roda em /api/*.
{
  "name": "esteiraergometrica",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
