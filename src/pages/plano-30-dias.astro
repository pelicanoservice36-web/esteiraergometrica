---
import BaseLayout from '../layouts/BaseLayout.astro';

// Link do checkout (Hotmart). Enquanto estiver vazio, a página sai com noindex e todo CTA
// mostra "em breve" em vez de fingir que a compra está aberta (ver hasCheckout abaixo:
// é usado em vários pontos da página, não só no botão final, pra não haver contradição
// entre "compre agora" no topo e "vendas abrem em breve" na oferta).
// Ao colar o link aqui, lembre de adicionar /plano-30-dias ao public/sitemap.xml.
// O acesso (login + senha) é enviado por e-mail automaticamente pelo app em
// app.esteiraergometrica.com quando a Hotmart avisa da compra; esta página só cobra.
const CHECKOUT_URL = '';
const PRECO = 'R$ 47';

const hasCheckout = CHECKOUT_URL.startsWith('https://');
// Link do próprio produto, não de afiliado: nofollow (checkout não precisa ser rastreado),
// sem "sponsored". Passado por spread para não cair na checagem T19b de CTAs de afiliado.
const checkoutAttrs = { href: CHECKOUT_URL, rel: 'nofollow noopener' };
const IMG = '/assets/images/plano-30-dias';

// "O que você recebe": lista fechada em 8 itens, cada um uma funcionalidade real do app
// (conferidas em Ebook/app/index.html) ou o bônus em PDF, que também é real (servido
// dentro do próprio app, atrás do login, depois da compra).
const inside = [
	{ t: '30 treinos guiados', d: 'Uma sequência organizada para os 30 dias, sem decidir nada sozinho.' },
	{ t: 'Cronômetro', d: 'Acompanha o tempo de cada etapa do treino, do aquecimento ao desaquecimento.' },
	{ t: 'Alertas durante o treino', d: 'Avisos sonoros e por voz na hora certa de mudar o ritmo ou a inclinação.' },
	{ t: 'Teste de esforço', d: 'Uma forma simples de saber se você está no ritmo certo, durante o próprio treino.' },
	{ t: 'Diário de evolução', d: 'Registre tempo, distância e esforço em segundos, direto no celular.' },
	{ t: 'Gráfico', d: 'Compare seu desempenho do Dia 1 ao Dia 30, sem precisar calcular nada.' },
	{ t: 'Acesso vitalício', d: 'Pague uma vez. O acesso ao app continua disponível depois da compra.' },
	{ t: 'Bônus: e-book em PDF', d: 'O material original do Plano 30 Dias, pra quem prefere consultar sem abrir o app.' },
];

// Mockups do treino guiado (não são screenshots: é a mesma tela, recriada em CSS a partir
// da interface real do app, em 3 momentos). Evita depender de imagem nova ou de capturar
// tela, e fica sempre igual ao app de verdade.
const demo = [
	{ cap: 'Abra o treino do dia', top: 'Dia 12 · Semana 2', what: 'Aquecimento', time: '3:00', inc: '0%', eff: 'Leve', bar: 6, icon: '▶' },
	{ cap: 'Siga o cronômetro e os alertas', top: 'Ciclo 2 de 4', what: 'subida forte', time: '1:42', inc: '6%', eff: 'Forte', bar: 58, icon: '❚❚' },
	{ cap: 'Termine e veja o resultado', top: 'Treino concluído', what: 'Dia 12 registrado', time: '✓', inc: '28 min', eff: 'Registrado', bar: 100, icon: '✓' },
];

// Comparação objetiva de estrutura (não é opinião sobre a qualidade de nenhum treino
// específico que exista por aí: é sobre organização e acompanhamento, que é o que o
// Plano 30 Dias resolve).
const diferencial = [
	['Você precisa escolher o treino', 'Sequência organizada'],
	['Cada vídeo pode ter uma proposta diferente', '30 dias estruturados'],
	['Difícil saber como progredir', 'Progressão planejada'],
	['Sem acompanhamento centralizado', 'Diário e gráfico de evolução'],
	['Precisa descobrir o que fazer', 'Abra o app e siga o treino'],
];

const weeks = [
	{ n: 'Semana 1', t: 'Adaptação', d: 'Objetivo: criar o hábito e aprender a controlar o esforço, com o teste inicial.', m: '15 a 26 min' },
	{ n: 'Semana 2', t: 'Construção', d: 'Objetivo: estabelecer a rotina, com mais tempo de treino e as primeiras subidas controladas.', m: '20 a 30 min' },
	{ n: 'Semana 3', t: 'Progressão', d: 'Objetivo: aumentar o desafio aos poucos, com intervalos e pirâmides de inclinação.', m: '20 a 35 min' },
	{ n: 'Semana 4', t: 'Consolidação', d: 'Objetivo: terminar o ciclo e comparar sua evolução, com os treinos mais longos e o teste final.', m: 'até 40 min' },
];

const faq = [
	{ q: 'Preciso ter uma esteira?', a: 'Sim, o plano foi feito para esteira (com ou sem inclinação). Se ainda não tem uma, os guias de compra do site ajudam a escolher.' },
	{ q: 'O plano funciona para iniciantes?', a: 'Funciona. A primeira semana tem treinos de 15 a 26 minutos em ritmo controlado, pensados para quem está começando.' },
	{ q: 'Preciso treinar todos os dias?', a: 'Não. O plano tem 4 dias de descanso nos 30 dias, já incluídos de propósito: fazem parte do resultado, não são uma falha sua.' },
	{ q: 'Quanto tempo por dia?', a: 'De 15 a 40 minutos, dependendo da semana.' },
	{ q: 'O acesso é vitalício?', a: 'Sim. É pagamento único, sem mensalidade, e o acesso ao app continua disponível depois da compra.' },
	{ q: 'O que recebo depois da compra?', a: 'Um e-mail com login e senha para entrar no app, direto no navegador, mais o e-book original em PDF, como bônus.' },
	{ q: 'Preciso baixar o app na App Store ou Google Play?', a: 'Não. É um Web App leve que roda direto no navegador do seu celular, sem loja de aplicativo. Dá para adicionar à tela inicial com um toque, se quiser.' },
	{ q: 'Funciona em qualquer esteira?', a: 'Sim. O app guia o seu esforço e o seu tempo, não depende de marca ou modelo: funciona com ou sem inclinação, em esteira de casa ou de academia.' },
	{ q: 'Posso cancelar?', a: 'Não é assinatura, então não há o que cancelar: é pagamento único. Se não for pra você, use a garantia de 7 dias e peça o reembolso.' },
	{ q: 'Existe garantia?', a: 'Sim, 7 dias, reembolso direto pela plataforma de pagamento.' },
	{ q: 'Minha esteira não tem inclinação. Serve?', a: 'Serve. O plano é guiado pelo esforço: sem inclinação, você ajusta a velocidade para chegar à mesma sensação.' },
	{ q: 'O plano promete emagrecimento?', a: 'Não. O plano ajuda a criar rotina e aumentar o gasto de energia. O resultado no peso depende também de alimentação, sono e constância.' },
];

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faq.map((f) => ({
		'@type': 'Question',
		name: f.q,
		acceptedAnswer: { '@type': 'Answer', text: f.a },
	})),
};
---

<BaseLayout
	title="Plano 30 Dias na Esteira: app guiado com cronômetro"
	description="App com 30 treinos guiados na esteira, cronômetro, alertas e teste de esforço interativo. Do primeiro passo a 40 minutos, direto no navegador."
	path="/plano-30-dias"
	ogTitle="Plano 30 Dias na Esteira: o app"
	ogDescription="Do primeiro passo a 40 minutos de treino. Um plano por dia, guiado por cronômetro, sem academia, no seu ritmo."
	ogImage={`${IMG}/og-plano-30-dias.jpg`}
	jsonLd={jsonLd}
	noindex={!hasCheckout}
>

<section class="lp-band lp-dark lp-hero">
	<div class="lp-hero-text">
		<span class="lp-tag">Novo: aplicativo interativo</span>
		<h1>Sua esteira parada virou cabide? Em 30 dias ela vira rotina.</h1>
		<p class="lp-lead">Um aplicativo que dita o seu ritmo, controla o seu tempo e avisa o momento exato de mudar a inclinação. Sem academia, sem planilha de papel, no seu celular.</p>
		<ul class="lp-checks lp-checks--light">
			<li>Cronômetro guiado com alertas sonoros e por voz</li>
			<li>Funciona com qualquer esteira, direto no navegador</li>
			<li>Teste no Dia 1 e no Dia 30, com gráfico de evolução automático</li>
		</ul>
		<div class="lp-cta-row">
			<a class="lp-btn" href="#oferta">Quero começar meus 30 dias</a>
			<p class="lp-cta-note">{hasCheckout ? <>Acesso vitalício · Pagamento único · {PRECO}</> : <>Em breve · Pagamento único · {PRECO}</>}</p>
		</div>
	</div>
	<div class="lp-hero-media">
		<img class="lp-hero-photo" src={`${IMG}/instrutora.webp`} width="640" height="1147" alt="Instrutora do Plano 30 Dias em casa, ao lado da esteira" fetchpriority="high">
		<!-- Mockup do app real (telas em app.esteiraergometrica.com), não uma imagem: evita
		     carregar mais uma foto e fica sempre consistente com a interface de verdade. -->
		<div class="lp-phone" aria-hidden="true">
			<div class="lp-phone-screen">
				<span class="lp-phone-top">Ciclo 2 de 4</span>
				<span class="lp-phone-what">subida forte</span>
				<span class="lp-phone-time">12:34</span>
				<div class="lp-phone-tiles">
					<div><small>Inclinação</small><b>4%</b></div>
					<div><small>Esforço</small><b>Forte</b></div>
				</div>
				<div class="lp-phone-bar"><i style="width:44%"></i></div>
				<span class="lp-phone-play">▶</span>
			</div>
		</div>
	</div>
</section>

<section class="lp-sec">
	<p class="lp-eyebrow">Se você se identifica…</p>
	<h2>O problema não é ter uma esteira. É saber como usar.</h2>
	<div class="lp-grid lp-grid--3">
		<div class="lp-card"><span class="lp-num">01</span><h3>Sobe e caminha sem rumo</h3><p>Sempre a mesma velocidade, o mesmo tempo, e a sensação de que não está saindo do lugar.</p></div>
		<div class="lp-card"><span class="lp-num">02</span><h3>Começa animado e para na 2ª semana</h3><p>Exagera nos primeiros dias, cansa, perde o ritmo e a esteira volta a juntar poeira.</p></div>
		<div class="lp-card"><span class="lp-num">03</span><h3>Não sabe se está evoluindo</h3><p>Sem um ponto de partida medido, fica impossível saber se o esforço está valendo a pena.</p></div>
	</div>
</section>

<section class="lp-band lp-white lp-sec">
	<p class="lp-eyebrow">Como funciona, na prática</p>
	<h2>Pense no Plano 30 Dias como um treinador no seu celular.</h2>
	<ol class="lp-steps">
		<li>Você abre o treino do dia.</li>
		<li>O app mostra o que fazer.</li>
		<li>O cronômetro acompanha o tempo.</li>
		<li>Os alertas indicam as mudanças de ritmo e inclinação.</li>
		<li>A progressão organiza os 30 dias por você.</li>
		<li>No final, você compara sua evolução.</li>
	</ol>
	<a class="lp-btn ghost" href="#recebe">Quero conhecer o plano</a>
</section>

<section class="lp-sec" id="demo">
	<p class="lp-eyebrow">Veja como funciona</p>
	<h2>A mesma tela, em três momentos do treino.</h2>
	<div class="lp-grid lp-grid--3">
		{demo.map((d) => (
			<figure class="lp-demo-shot">
				<div class="lp-phone lp-phone--static">
					<div class="lp-phone-screen">
						<span class="lp-phone-top">{d.top}</span>
						<span class="lp-phone-what">{d.what}</span>
						<span class="lp-phone-time">{d.time}</span>
						<div class="lp-phone-tiles">
							<div><small>Inclinação</small><b>{d.inc}</b></div>
							<div><small>Esforço</small><b>{d.eff}</b></div>
						</div>
						<div class="lp-phone-bar"><i style={`width:${d.bar}%`}></i></div>
						<span class="lp-phone-play">{d.icon}</span>
					</div>
				</div>
				<figcaption>{d.cap}</figcaption>
			</figure>
		))}
	</div>
	<p class="lp-fine-note">Recriado em código a partir da interface real do app, não é uma captura de tela.</p>
</section>

<section class="lp-band lp-white lp-sec" id="recebe">
	<p class="lp-eyebrow">O que você recebe</p>
	<h2>Tudo decidido para você. Só apertar o play da esteira.</h2>
	<div class="lp-grid lp-grid--4">
		{inside.map((i) => (
			<div class="lp-card lp-card--sunk"><h3>{i.t}</h3><p>{i.d}</p></div>
		))}
	</div>
</section>

<section class="lp-sec">
	<p class="lp-eyebrow">Como funcionam os 30 dias</p>
	<h2>4 semanas, uma evolução de cada vez.</h2>
	<div class="lp-grid lp-grid--4">
		{weeks.map((w, i) => (
			<div class:list={['lp-card', 'lp-week', { 'lp-week--last': i === 3 }]}>
				<span class="lp-week-n">{w.n}</span>
				<h3>{w.t}</h3>
				<p>{w.d}</p>
				<strong>{w.m}</strong>
			</div>
		))}
	</div>
</section>

<section class="lp-band lp-dark lp-sec">
	<p class="lp-eyebrow">Acompanhamento</p>
	<h2>Não é apenas treinar. É conseguir enxergar sua evolução.</h2>
	<div class="lp-flow">
		<div class="lp-flow-box"><b>Dia 1</b><span>Teste inicial</span></div>
		<span class="lp-flow-arrow">→</span>
		<div class="lp-flow-box lp-flow-box--mid"><b>30 dias</b><span>De constância</span></div>
		<span class="lp-flow-arrow">→</span>
		<div class="lp-flow-box"><b>Dia 30</b><span>Teste final</span></div>
	</div>
	<p class="lp-flow-note">O app registra o teste do Dia 1 e do Dia 30 e monta a comparação sozinho: distância, esforço percebido e um gráfico de evolução. Sem prometer um número de resultado: o que o plano garante é o acompanhamento, não o resultado em si, que depende de constância, alimentação e sono.</p>
</section>

<section class="lp-sec">
	<p class="lp-eyebrow">"Mas eu posso encontrar treinos grátis na internet"</p>
	<h2>Pode. E esse não é o problema.</h2>
	<p class="lp-lead2">O problema é encontrar um treino hoje, outro amanhã, não saber quando aumentar o esforço e não ter uma sequência organizada. O Plano 30 Dias reúne os treinos numa jornada organizada para você não precisar decidir tudo sozinho.</p>
	<div class="lp-compare-wrap">
	<table class="lp-compare">
		<thead><tr><th scope="col">Treinos aleatórios</th><th scope="col">Plano 30 Dias</th></tr></thead>
		<tbody>
			{diferencial.map(([a, b]) => (
				<tr><td>{a}</td><td>{b}</td></tr>
			))}
		</tbody>
	</table>
	</div>
</section>

<section class="lp-sec lp-grid lp-grid--2">
	<div class="lp-card lp-card--pad">
		<h3 class="lp-h3">Para quem é</h3>
		<ul class="lp-checks">
			<li>Comprou uma esteira e quase não usa</li>
			<li>Está voltando a se exercitar</li>
			<li>Quer começar a caminhar em casa</li>
			<li>Prefere seguir uma orientação pronta</li>
		</ul>
	</div>
	<div class="lp-card lp-card--pad">
		<h3 class="lp-h3">Para quem não é</h3>
		<ul class="lp-checks lp-checks--no">
			<li>Não é para atletas buscando treinamento avançado</li>
			<li>Não substitui acompanhamento médico ou profissional individualizado</li>
			<li>Não promete emagrecimento automático em 30 dias</li>
			<li>Não é uma fórmula milagrosa</li>
		</ul>
	</div>
</section>

<section class="lp-band lp-dark lp-sec">
	<p class="lp-eyebrow">Por dentro do e-book (bônus)</p>
	<h2>Claro de ler, fácil de seguir no celular ou impresso.</h2>
	<div class="lp-grid lp-grid--3">
		<figure class="lp-shot"><img src={`${IMG}/pagina-esforco.webp`} width="720" height="1018" loading="lazy" alt="Página do e-book com a regra de ouro do esforço"><figcaption>A regra de ouro: esforço antes da velocidade</figcaption></figure>
		<figure class="lp-shot"><img src={`${IMG}/pagina-treinos.webp`} width="720" height="1018" loading="lazy" alt="Página do e-book com os treinos da Semana 1"><figcaption>Treino do dia, bloco a bloco</figcaption></figure>
		<figure class="lp-shot"><img src={`${IMG}/pagina-planilha.webp`} width="720" height="1018" loading="lazy" alt="Planilha de progresso de 30 dias"><figcaption>Planilha para marcar cada dia</figcaption></figure>
	</div>
</section>

<section id="oferta" class="lp-offer-wrap">
	<div class="lp-offer">
		<img src={`${IMG}/app-icon.png`} width="200" height="200" loading="lazy" alt="Ícone do app Plano 30 Dias na Esteira">
		<h2>Comece seus 30 dias hoje</h2>
		<p class="lp-offer-sub">Plano 30 Dias</p>
		<ul class="lp-checks">
			<li>30 treinos guiados</li>
			<li>Cronômetro</li>
			<li>Alertas durante os treinos</li>
			<li>Teste de esforço</li>
			<li>Diário e gráfico de evolução</li>
			<li>Acesso vitalício</li>
			<li>Bônus: e-book em PDF</li>
		</ul>
		<p class="lp-price"><span>pagamento único</span><strong>{PRECO}</strong><span>no Pix ou cartão</span></p>
		{hasCheckout
			? <a class="lp-btn lp-btn--full" {...checkoutAttrs}>Quero começar meus 30 dias</a>
			: <span class="lp-btn lp-btn--full lp-btn--off" aria-disabled="true">Vendas abrem em breve</span>}
		{hasCheckout && <p class="lp-guarantee">Garantia de 7 dias: não gostou, devolvemos seu dinheiro.<br>Acesso por e-mail (login e senha), em minutos após a confirmação do pagamento.</p>}
	</div>
</section>

<section class="lp-sec">
	<p class="lp-eyebrow">Garantia</p>
	<h2>Você tem 7 dias para conhecer o Plano 30 Dias.</h2>
	<p class="lp-lead2">Se não for pra você, é só pedir o reembolso direto pela plataforma de pagamento, sem burocracia. A garantia vale a partir da data da compra.</p>
</section>

<section class="lp-band lp-white lp-sec">
	<h2>Perguntas frequentes</h2>
	<div class="lp-grid lp-grid--2">
		{faq.map((f) => (
			<div class="lp-card lp-card--sunk"><h3>{f.q}</h3><p>{f.a}</p></div>
		))}
	</div>
</section>

<section class="lp-band lp-dark lp-sec lp-final">
	<h2>Sua esteira já está aí.</h2>
	<p class="lp-lead2" style="color:var(--lp-light)">Agora falta transformar intenção em rotina.</p>
	<a class="lp-btn" href="#oferta">Começar meus 30 dias</a>
	<p class="lp-cta-note" style="margin-top:1rem">{PRECO} · pagamento único · {hasCheckout ? 'acesso vitalício' : 'em breve'}</p>
</section>

<p class="lp-disclaimer">Material educativo. Não substitui avaliação médica nem orientação individual de um profissional de educação física. Resultados variam de pessoa para pessoa. A instrutora exibida é uma personagem criada com inteligência artificial.</p>

<!-- Barra fixa só no celular, só depois de rolar a página: ajuda o CTA sem brigar com o
     conteúdo acima da dobra nem tampar nada importante (o próprio texto diz "em breve"
     quando o checkout ainda não está ativo, pra não contradizer a oferta). -->
<div id="lp-sticky" class="lp-sticky" role="complementary" aria-label="Oferta">
	<span>Plano 30 Dias <b>{PRECO}</b></span>
	<a class="lp-btn sm" href="#oferta">{hasCheckout ? 'Começar agora' : 'Ver detalhes'}</a>
</div>
<script is:inline>
	(function () {
		var bar = document.getElementById('lp-sticky');
		if (!bar) return;
		var shown = false;
		addEventListener('scroll', function () {
			var should = scrollY > innerHeight * 0.6;
			if (should !== shown) { shown = should; bar.classList.toggle('on', should); }
		}, { passive: true });
	})();
</script>

</BaseLayout>

<style>
	/* Paleta própria do produto (a mesma do ebook), isolada nesta página.
	   CSS escopado aqui em vez de src/styles.css porque o CSS global é inline em
	   toda página do site: estas regras só servem a esta URL. */
	.lp-band, .lp-offer-wrap, .lp-sec, .lp-disclaimer, .lp-sticky {
		--lp-navy: #0B2545;
		--lp-orange: #F26A1B;
		--lp-btn: #C2410C;
		--lp-btn-hover: #9A3412;
		--lp-cream: #F6F4EF;
		--lp-muted: #4A5568;
		--lp-light: #C9D4E5;
	}
	/* Faixa de largura total sem estourar a rolagem horizontal. */
	.lp-band { position: relative; background: var(--lp-bg); box-shadow: 0 0 0 100vmax var(--lp-bg); clip-path: inset(0 -100vmax); }
	.lp-dark { --lp-bg: #0B2545; color: #fff; }
	.lp-white { --lp-bg: #fff; }

	.lp-sec { padding: 4rem 0; }
	.lp-sec h2, .lp-offer h2 { margin: 0 0 2rem; font-size: clamp(1.75rem, 3.6vw, 2.75rem); line-height: 1.15; font-weight: 800; color: var(--lp-navy); letter-spacing: -0.02em; max-width: 52rem; }
	.lp-dark h2, .lp-dark h1 { color: #fff; }
	.lp-eyebrow { margin: 0 0 0.75rem; font-size: 0.8rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--lp-btn); }
	.lp-dark .lp-eyebrow { color: var(--lp-orange); }
	.lp-lead2 { font-size: 1.05rem; line-height: 1.6; color: var(--lp-muted); max-width: 44rem; margin: 0 0 1.5rem; }

	.lp-hero { display: grid; gap: 2.5rem; padding: 3rem 0 4rem; align-items: center; }
	.lp-tag { display: inline-block; background: var(--lp-orange); color: var(--lp-navy); font-size: 0.8rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; padding: 0.4rem 0.8rem; border-radius: 6px; }
	.lp-hero h1 { margin: 1.25rem 0 1rem; font-size: clamp(2.1rem, 5vw, 3.6rem); line-height: 1.08; font-weight: 800; letter-spacing: -0.02em; }
	.lp-lead { margin: 0 0 1.5rem; font-size: 1.15rem; line-height: 1.6; color: var(--lp-light); }
	.lp-hero-media { position: relative; min-height: 26rem; }
	.lp-hero-photo { position: absolute; right: 0; top: 0; width: 72%; height: 100%; object-fit: cover; object-position: center top; border-radius: 20px; }
	/* Mockup CSS do telefone com a tela do treino guiado. --static vira um cartão normal
	   (usado na seção "Veja como funciona"); sem o modificador, fica sobreposto no hero. */
