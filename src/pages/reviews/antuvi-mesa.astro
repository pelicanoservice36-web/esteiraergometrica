// marca declarada "Geral") saiu do ar e o link de afiliado passou a cair numa página genérica.
// Esta análise passou a cobrir o modelo atual da loja oficial Antuvi, a partir da página do
// anúncio salva pelo dono do site em 14/11/2026 (ficha técnica, descrição e avaliações).
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Product',
	name: 'Esteira Elétrica Ergométrica Antuvi Dobrável 150 kg',
	category: 'Esteira ergométrica',
	brand: { '@type': 'Brand', name: 'Antuvi' },
	offers: {
		'@type': 'AggregateOffer',
		priceCurrency: 'BRL',
		lowPrice: '1039.85',
		highPrice: '1039.85',
		offerCount: '1',
		availability: 'https://schema.org/InStock',
	},
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: '5.0',
		reviewCount: '2',
		bestRating: '5',
		worstRating: '1',
	},
	review: {
		'@type': 'Review',
		reviewRating: {
			'@type': 'Rating',
			ratingValue: '6.8',
			bestRating: '10',
			worstRating: '0',
		},
		author: { '@type': 'Person', name: 'Rafael Rodrigues', url: 'https://esteiraergometrica.com/sobre' },
