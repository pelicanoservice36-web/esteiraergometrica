            <th scope="col">Velocidade máx.</th>
            <th scope="col">Lona</th>
            <th scope="col">Peso máx.</th>
            <th scope="col">Dobra</th>
            <th scope="col">Preço</th>
            <th scope="col"><span class="visually-hidden">Ação</span></th>
