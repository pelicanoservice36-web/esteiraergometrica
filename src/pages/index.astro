const mlGallant28 = buyHref('gallant-elite-gee12m28a');
const mlPodiumfit = buyHref('podiumfit-x300');
const mlQbuen = buyHref('qbuen-150kg');
const mlStrive = buyHref('strive-25hp-16kmh');
const mlRedfin = buyHref('redfin-150kg');
const mlHealthHerald = buyHref('health-herald-lcd');
const mlAntuvi = buyHref('antuvi-mesa');
// Os CTAs da home dizem só "Ver melhor preço": o title nomeia o destino,
// exigência da cláusula 1.8 dos Termos do Programa de Afiliados do ML.
const mlTitle = 'Ir para o anúncio no Mercado Livre';

const check = '<polyline points="5,13 9,17 19,7" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" fill="none"/>';
