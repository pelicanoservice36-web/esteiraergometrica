---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Página não encontrada — esteiraergometrica.com"
	description="Essa página não existe ou foi movida. Veja o comparativo de esteiras ergométricas ou volte para a página inicial."
	path="/404"
	ogTitle="Página não encontrada"
	ogDescription="Essa página não existe ou foi movida."
>

  <div class="lead-section" style="text-align:center; padding-block: 3rem;">
    <p class="stamp">Erro 404</p>
    <h1>Essa página não existe</h1>
    <p class="standfirst">O link pode estar quebrado, desatualizado, ou você digitou o endereço errado. Nenhum produto, review ou guia vive nesse endereço.</p>

    <div class="hero-actions" style="justify-content:center; margin-top:1.5rem;">
      <a class="btn btn-primary" href="/">Ir para a página inicial</a>
      <a class="btn btn-secondary" href="/#comparativo">Ver comparativo de esteiras</a>
    </div>
  </div>

</BaseLayout>
