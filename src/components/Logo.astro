---
export interface Props {
	class?: string;
}

const { class: className = '' } = Astro.props;
---

<a href="/" class:list={['brand', className]} aria-label="esteiraergometrica.com — página inicial">
	<svg class="brand-mark" width="30" height="30" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
		<line x1="4" y1="20.5" x2="24" y2="20.5" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" />
		<line x1="9" y1="18.4" x2="12.6" y2="16.7" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" opacity="0.35" />
		<line x1="12.4" y1="16" x2="15.6" y2="14.1" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" opacity="0.6" />
		<line x1="17.4" y1="15.6" x2="19.4" y2="20.5" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" />
		<circle cx="19.4" cy="12.4" r="2.6" fill="currentColor" />
	</svg>
	<span class="brand-word"><strong>esteira</strong>ergometrica.com</span>
</a>
