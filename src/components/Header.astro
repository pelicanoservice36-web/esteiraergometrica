---
import Logo from './Logo.astro';

export interface Props {
	transparent?: boolean;
}

const { transparent = false } = Astro.props;
---

<header class:list={['site-head', { 'site-head--overlay': transparent }]}>
  <div class="wrap">
    <Logo />

    <nav class="site-nav" aria-label="Navegação principal">
      <a href="/#comparativo" class="is-featured">Comparativo</a>
      <a href="/#analises">Análises</a>
      <a href="/#guias">Guias</a>
    </nav>

    <details class="mobile-nav">
      <summary aria-label="Abrir menu">
        <span class="hamburger"><span></span><span></span><span></span></span>
      </summary>
      <nav class="mobile-nav-panel" aria-label="Navegação principal">
        <a href="/#comparativo">Comparativo</a>
        <a href="/#analises">Análises</a>
        <a href="/#guias">Guias</a>
      </nav>
    </details>
  </div>
</header>

{transparent && (
	<script is:inline>
		(function () {
			var header = document.querySelector('.site-head--overlay');
			if (!header) return;
			var onScroll = function () {
				header.classList.toggle('is-scrolled', window.scrollY > 60);
			};
			onScroll();
			window.addEventListener('scroll', onScroll, { passive: true });
		})();
	</script>
)}
