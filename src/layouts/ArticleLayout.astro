---
import BaseLayout from './BaseLayout.astro';

export interface Props {
	title: string;
	description: string;
	path: string;
	ogTitle?: string;
	ogDescription?: string;
	ogType?: 'website' | 'article';
	jsonLd?: Record<string, unknown>;
	h1: string;
	standfirst: string;
	updated: string;
}

const {
	title,
	description,
	path,
	ogTitle,
	ogDescription,
	ogType = 'article',
	jsonLd,
	h1,
	standfirst,
	updated,
} = Astro.props;
---

<BaseLayout
	title={title}
	description={description}
	path={path}
	ogTitle={ogTitle}
	ogDescription={ogDescription}
	ogType={ogType}
	jsonLd={jsonLd}
>
<article>

  <div class="lead-section">
    <h1>{h1}</h1>
    <p class="standfirst">{standfirst}</p>
    <p class="stamp">Atualizado em {updated}</p>
  </div>

  <slot />

</article>
</BaseLayout>
