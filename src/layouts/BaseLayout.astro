---
import '../styles.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

export interface Props {
	title: string;
	description: string;
	path: string;
	ogTitle?: string;
	ogDescription?: string;
	ogType?: 'website' | 'article';
	ogImage?: string;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
	transparentHeader?: boolean;
	noindex?: boolean;
}

const {
	title,
	description,
	path,
	ogTitle = title,
	ogDescription = description,
	ogType = 'website',
	ogImage = '/video/esteiraergometricahead-poster.webp',
	jsonLd,
	transparentHeader = false,
	noindex = false,
} = Astro.props;

// Google Ads: tag e conversão de clique no link de afiliado. Os dois valores vêm
// de variáveis de ambiente PÚBLICAS (definidas no painel do Cloudflare Pages,
// lidas no build). Enquanto o ID real não for configurado, o placeholder
// AW-XXXXXXXXX/YYYYYYYYYY fica valendo e o código do Ads NÃO é emitido: nada é
// enviado com ID falso. Ver .env.example.
// IDs públicos (aparecem no HTML de qualquer forma); env do Cloudflare sobrescreve se definida.
// Conversão "Clique ML (tag direta)" na conta 624-356-6182 — SECUNDÁRIA (a principal é o
// affiliate_click importado do GA4); não promover as duas a principal, conta em dobro.
const GADS_ID = (import.meta.env.PUBLIC_GADS_ID || 'AW-18556642466').trim();
const GADS_SEND_TO = (import.meta.env.PUBLIC_GADS_CONVERSION || 'AW-18556642466/Wn4yCJLczrQdEKLJv5BF').trim();
const gadsEnabled = /^AW-\d+$/.test(GADS_ID) && /^AW-\d+\/[\w-]+$/.test(GADS_SEND_TO);

const canonicalURL = new URL(path, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);

// BreadcrumbList genérico, de Início até a página atual. Não usa um nível
// intermediário (ex.: "Reviews", "Guias") porque /reviews/ e /guias/ não são
// páginas reais do site: um ListItem "clicável" pra uma URL que não existe
// seria pior que não ter breadcrumb. Home não recebe este schema: página
// de 1 nível não precisa de trilha.
const breadcrumbJsonLd = path === '/' ? null : {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Início', item: new URL('/', Astro.site).toString() },
		{ '@type': 'ListItem', position: 2, name: title },
	],
};
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content={noindex ? 'noindex, follow' : 'max-image-preview:large'}>

<!-- Google tag (gtag.js) -->
<script is:inline>
	// Acessos do dono do site ficam fora do Analytics. Abrir qualquer página com
	// ?interno=1 liga a exclusão NESTE navegador (fica guardada no localStorage);
	// ?interno=0 desliga. A flag ga-disable-<ID> precisa existir antes do config.
	try {
		var interno = new URLSearchParams(location.search).get('interno');
		if (interno === '1') { localStorage.setItem('ga-interno', '1'); alert('Pronto: os acessos deste navegador não contam mais no Analytics.'); }
		if (interno === '0') { localStorage.removeItem('ga-interno'); alert('Os acessos deste navegador voltaram a contar no Analytics.'); }
		if (localStorage.getItem('ga-interno') === '1') window['ga-disable-G-F3SC734W1X'] = true;
	} catch (e) {}
	window.dataLayer = window.dataLayer || [];
	function gtag(){dataLayer.push(arguments);}
	window.gtag = gtag;
	var storedConsent = 'denied';
	try {
		if (localStorage.getItem('cookie-consent') === 'accepted') storedConsent = 'granted';
	} catch (e) {}
	// ad_* acompanham analytics_storage: a mesma escolha do banner vale para o
	// Google Ads (sem aceite, o Ads não grava cookie e só recebe sinal sem cookie).
	gtag('consent', 'default', {
		analytics_storage: storedConsent,
		ad_storage: storedConsent,
		ad_user_data: storedConsent,
		ad_personalization: 'denied',
	});
	gtag('js', new Date());
	gtag('config', 'G-F3SC734W1X');

	// A biblioteca do gtag (166 KiB, ~430ms de main thread) só entra depois da
	// primeira interação real do visitante (scroll, toque, tecla, clique,
	// mouse) ou, na ausência de qualquer interação, num atraso fixo de 7s:
	// os comandos gtag() acima já ficam na fila do dataLayer e são
	// processados assim que o script real chega, então nenhum evento de
	// analytics é perdido, só adiado.
	//
	// Tentamos requestIdleCallback antes disso (com timeout de 4s, depois
	// 8s) e não funcionou: numa página estática como esta, o navegador se
	// considera "ocioso" quase imediatamente após o `load`, sem trabalho
	// contínuo de verdade no main thread, o requestIdleCallback disparava a
	// poucas centenas de ms do load, timeout ou não, e o gtag continuava
	// caindo dentro da janela de TBT/Total Blocking Time do PageSpeed.
	// setTimeout com atraso fixo é determinístico e realmente empurra a
	// carga do gtag para depois da janela de medição.
	var gtagLoaded = false;
	var INTERACTION_EVENTS = ['scroll', 'keydown', 'click', 'touchstart', 'mousemove'];
	function loadGtagScript() {
		if (gtagLoaded) return;
		gtagLoaded = true;
		INTERACTION_EVENTS.forEach(function (evt) {
			window.removeEventListener(evt, loadGtagScript);
		});
		var s = document.createElement('script');
		s.async = true;
		s.src = 'https://www.googletagmanager.com/gtag/js?id=G-F3SC734W1X';
		document.head.appendChild(s);
	}
	INTERACTION_EVENTS.forEach(function (evt) {
		window.addEventListener(evt, loadGtagScript, { passive: true, once: true });
	});
	if (document.readyState === 'complete') {
		setTimeout(loadGtagScript, 7000);
	} else {
		window.addEventListener('load', function () {
			setTimeout(loadGtagScript, 7000);
		});
	}
</script>

{gadsEnabled && (
	<script is:inline define:vars={{ GADS_ID }}>
		gtag('config', GADS_ID);
	</script>
)}

<!-- Clique nos CTAs de afiliado, como evento affiliate_click (GA4) e, quando o
     Google Ads estiver configurado, como conversão do Ads.

     Quais links contam: href começando com /go/ (linkMode 'redirect'), qualquer
     <a data-affiliate-link> e qualquer link rel="sponsored" (todo CTA de compra
     do site leva rel="sponsored", inclusive no linkMode 'direct'). Delegado em
     document, então cobre todas as páginas sem atributo por botão.

     Parâmetros do Google (utm_*, gclid, campaignid, adgroupid, keyword...) da URL
     da página vão JUNTO DO EVENTO, não no link. O link de afiliado do Mercado
     Livre segue intacto, byte a byte: acrescentar parâmetro a ele viola o item
     1.8 dos Termos do Programa de Afiliados ("edição ou modificação dos Links
     Especiais") e a mitigação M7 de AFFILIATE_IMPLEMENTATION.md §12.1.

     Envio antes de sair da página: gtag usa transporte beacon (sendBeacon).
     Todo CTA de afiliado abre em target="_blank", então a aba atual não
     descarrega e não precisa atrasar nada. Só um link que abra na MESMA aba
     é segurado, até o gtag confirmar o envio ou no máximo 150 ms. -->
<script is:inline define:vars={{ GADS_SEND_TO: gadsEnabled ? GADS_SEND_TO : '' }}>
	var TRACK_PARAMS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'gclid', 'gbraid', 'wbraid', 'campaignid', 'adgroupid', 'keyword', 'matchtype', 'device'];
	function adParams() {
		var out = {};
		try {
			var q = new URLSearchParams(location.search);
			TRACK_PARAMS.forEach(function (k) { var v = q.get(k); if (v) out[k] = v.slice(0, 100); });
		} catch (e) {}
		return out;
	}
	document.addEventListener('click', function (e) {
		var link = e.target.closest && e.target.closest('a[href^="/go/"], a[data-affiliate-link], a[rel~="sponsored"]');
		if (!link) return;
		var href = link.getAttribute('href') || '';
		var params = adParams();
		var data = {
			event_category: 'affiliate',
			event_label: href.split('?')[0].split('/').pop(),
			link_url: href,
			page_path: location.pathname,
			transport_type: 'beacon',
		};
		for (var k in params) data[k] = params[k];
		gtag('event', 'affiliate_click', data);

		if (!GADS_SEND_TO) return;
		var sameTab = !link.target || link.target === '_self';
		var plainClick = e.button === 0 && !e.metaKey && !e.ctrlKey && !e.shiftKey && !e.altKey;
		if (sameTab && plainClick) {
			e.preventDefault();
			var gone = false;
			var go = function () { if (gone) return; gone = true; location.href = link.href; };
			gtag('event', 'conversion', { send_to: GADS_SEND_TO, transport_type: 'beacon', event_callback: go });
			setTimeout(go, 150);
		} else {
			gtag('event', 'conversion', { send_to: GADS_SEND_TO, transport_type: 'beacon' });
		}
	});
</script>

<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonicalURL}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta name="msvalidate.01" content="DFB2D49D993A677130598E90FB30F488" />

<meta property="og:type" content={ogType}>
<meta property="og:title" content={ogTitle}>
<meta property="og:description" content={ogDescription}>
<meta property="og:url" content={canonicalURL}>
<meta property="og:image" content={ogImageURL}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={ogTitle}>
<meta name="twitter:description" content={ogDescription}>
<meta name="twitter:image" content={ogImageURL}>

<link rel="preload" as="font" type="font/woff2" href="/fonts/manrope-latin.woff2" crossorigin>

{transparentHeader && (
	// O poster do vídeo do hero é o elemento de LCP da home, mas fetchpriority="high"
	// na tag <video> não se propaga pro fetch do atributo poster (limitação conhecida
	// dos navegadores): precisa desse preload dedicado pra imagem ser priorizada de fato.
	<link rel="preload" as="image" href="/video/esteiraergometricahead-poster.webp" fetchpriority="high">
)}

{jsonLd && (
	Array.isArray(jsonLd)
		? jsonLd.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)
		: <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
)}
{breadcrumbJsonLd && (
	<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
)}
</head>
<body>

<Header transparent={transparentHeader} />

{path !== '/' && (
	<nav class="breadcrumbs wrap" aria-label="Trilha de navegação">
		<a href="/">Início</a>
		<span class="breadcrumbs__sep" aria-hidden="true">›</span>
		<span class="breadcrumbs__current" aria-current="page">{title}</span>
	</nav>
)}

<main class="wrap">
	<slot />
</main>

<Footer />

<div id="cookie-banner" class="cookie-banner" hidden>
	<h2 class="cookie-banner__title">Cookies</h2>
	<p class="cookie-banner__text">Usamos cookies para entender como você usa o site, melhorar sua experiência e medir o resultado dos nossos anúncios no Google. Isso não afeta a navegação. Ao clicar em "Aceitar", você concorda com esse uso, conforme descrito na nossa <a href="/politica-de-cookies">Política de Cookies</a>.</p>
	<div class="cookie-banner__actions">
		<button type="button" id="cookie-accept" class="btn btn-primary">Aceitar</button>
		<button type="button" id="cookie-reject" class="btn btn-secondary">Recusar</button>
	</div>
</div>

<script is:inline>
(function () {
	var KEY = 'cookie-consent';
	var banner = document.getElementById('cookie-banner');
	var saved = null;
	try { saved = localStorage.getItem(KEY); } catch (e) {}

	if (!saved) banner.hidden = false;

	document.getElementById('cookie-accept').addEventListener('click', function () {
		try { localStorage.setItem(KEY, 'accepted'); } catch (e) {}
		gtag('consent', 'update', { analytics_storage: 'granted', ad_storage: 'granted', ad_user_data: 'granted' });
		banner.hidden = true;
	});

	document.getElementById('cookie-reject').addEventListener('click', function () {
		try { localStorage.setItem(KEY, 'rejected'); } catch (e) {}
		gtag('consent', 'update', { analytics_storage: 'denied', ad_storage: 'denied', ad_user_data: 'denied' });
		banner.hidden = true;
	});
})();
</script>

</body>
</html>
