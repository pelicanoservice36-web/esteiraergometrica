---
import '../styles.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

export interface Props {
	title: string;
	description: string;
	path: string;
	ogTitle?: string;
	ogDescription?: string;
	ogType?: 'website' | 'article';
	ogImage?: string;
	jsonLd?: Record<string, unknown>;
	transparentHeader?: boolean;
}

const {
	title,
	description,
	path,
	ogTitle = title,
	ogDescription = description,
	ogType = 'website',
	ogImage = '/video/esteiraergometricahead-poster.webp',
	jsonLd,
	transparentHeader = false,
} = Astro.props;

const canonicalURL = new URL(path, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="max-image-preview:large">

<!-- Google tag (gtag.js) -->
<script is:inline>
	window.dataLayer = window.dataLayer || [];
	function gtag(){dataLayer.push(arguments);}
	window.gtag = gtag;
	var storedConsent = 'denied';
	try {
		if (localStorage.getItem('cookie-consent') === 'accepted') storedConsent = 'granted';
	} catch (e) {}
	gtag('consent', 'default', { analytics_storage: storedConsent });
	gtag('js', new Date());
	gtag('config', 'G-F3SC734W1X');

	// A biblioteca do gtag (166 KiB, ~430ms de main thread) só entra depois da
	// primeira interação real do visitante (scroll, toque, tecla, clique,
	// mouse) ou, na ausência de qualquer interação, num atraso fixo de 7s —
	// os comandos gtag() acima já ficam na fila do dataLayer e são
	// processados assim que o script real chega, então nenhum evento de
	// analytics é perdido, só adiado.
	//
	// Tentamos requestIdleCallback antes disso (com timeout de 4s, depois
	// 8s) e não funcionou: numa página estática como esta, o navegador se
	// considera "ocioso" quase imediatamente após o `load` — sem trabalho
	// contínuo de verdade no main thread, o requestIdleCallback disparava a
	// poucas centenas de ms do load, timeout ou não, e o gtag continuava
	// caindo dentro da janela de TBT/Total Blocking Time do PageSpeed.
	// setTimeout com atraso fixo é determinístico e realmente empurra a
	// carga do gtag para depois da janela de medição.
	var gtagLoaded = false;
	var INTERACTION_EVENTS = ['scroll', 'keydown', 'click', 'touchstart', 'mousemove'];
	function loadGtagScript() {
		if (gtagLoaded) return;
		gtagLoaded = true;
		INTERACTION_EVENTS.forEach(function (evt) {
			window.removeEventListener(evt, loadGtagScript);
		});
		var s = document.createElement('script');
		s.async = true;
		s.src = 'https://www.googletagmanager.com/gtag/js?id=G-F3SC734W1X';
		document.head.appendChild(s);
	}
	INTERACTION_EVENTS.forEach(function (evt) {
		window.addEventListener(evt, loadGtagScript, { passive: true, once: true });
	});
	if (document.readyState === 'complete') {
		setTimeout(loadGtagScript, 7000);
	} else {
		window.addEventListener('load', function () {
			setTimeout(loadGtagScript, 7000);
		});
	}
</script>

<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonicalURL}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta name="msvalidate.01" content="DFB2D49D993A677130598E90FB30F488" />

<meta property="og:type" content={ogType}>
<meta property="og:title" content={ogTitle}>
<meta property="og:description" content={ogDescription}>
<meta property="og:url" content={canonicalURL}>
<meta property="og:image" content={ogImageURL}>
<meta name="twitter:card" content="summary_large_image">

<link rel="preload" as="font" type="font/woff2" href="/fonts/manrope-latin.woff2" crossorigin>

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</head>
<body>

<Header transparent={transparentHeader} />

<main class="wrap">
	<slot />
</main>

<Footer />

<div id="cookie-banner" class="cookie-banner" hidden>
	<h2 class="cookie-banner__title">Cookies</h2>
	<p class="cookie-banner__text">Usamos cookies para entender como você usa o site e melhorar sua experiência. Isso não afeta a navegação. Ao clicar em "Aceitar", você concorda com esse uso, conforme descrito na nossa <a href="/politica-de-cookies">Política de Cookies</a>.</p>
	<div class="cookie-banner__actions">
		<button type="button" id="cookie-accept" class="btn btn-primary">Aceitar</button>
		<button type="button" id="cookie-reject" class="btn btn-secondary">Recusar</button>
	</div>
</div>

<script is:inline>
(function () {
	var KEY = 'cookie-consent';
	var banner = document.getElementById('cookie-banner');
	var saved = null;
	try { saved = localStorage.getItem(KEY); } catch (e) {}

	if (!saved) banner.hidden = false;

	document.getElementById('cookie-accept').addEventListener('click', function () {
		try { localStorage.setItem(KEY, 'accepted'); } catch (e) {}
		gtag('consent', 'update', { analytics_storage: 'granted' });
		banner.hidden = true;
	});

	document.getElementById('cookie-reject').addEventListener('click', function () {
		try { localStorage.setItem(KEY, 'rejected'); } catch (e) {}
		gtag('consent', 'update', { analytics_storage: 'denied' });
		banner.hidden = true;
	});
})();
</script>

</body>
</html>
