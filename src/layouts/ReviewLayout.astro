---
import BaseLayout from './BaseLayout.astro';

export interface FichaItem {
	label: string;
	value: string;
}

export interface Props {
	title: string;
	description: string;
	path: string;
	ogTitle?: string;
	ogDescription?: string;
	ogImage?: string;
	jsonLd?: Record<string, unknown>;
	h1: string;
	standfirst: string;
	updated: string;
	fichaItems: FichaItem[];
	buyHref: string;
	priceNote: string;
	buyLabel?: string;
}

const {
	title,
	description,
	path,
	ogTitle,
	ogDescription,
	ogImage,
	jsonLd,
	h1,
	standfirst,
	updated,
	fichaItems,
	buyHref,
	priceNote,
	buyLabel = 'Ver preço no Mercado Livre',
} = Astro.props;

// Cada review tem uma capa própria em public/assets/images/<slug>-cover.webp
// (1200×624, foto real do produto sobre fundo de marca — gerada por composição
// determinística, sem IA, para ficar acima do mínimo de 1200px que o Google
// Discover exige; a foto de 500px original não é grande o suficiente sozinha).
const slug = path.replace(/^\/reviews\//, '').replace(/\.html$/, '');
const defaultOgImage = `/assets/images/${slug}-cover.webp`;
---

<BaseLayout
	title={title}
	description={description}
	path={path}
	ogTitle={ogTitle}
	ogDescription={ogDescription}
	ogImage={ogImage ?? defaultOgImage}
	ogType="article"
	jsonLd={jsonLd}
>
<article>

  <div class="lead-section">
    <h1>{h1}</h1>
    <p class="standfirst">{standfirst}</p>
    <p class="stamp">Atualizado em {updated}</p>
  </div>

  <section class="ficha">
    <dl>
      {fichaItems.map((item) => (
        <div><dt>{item.label}</dt><dd>{item.value}</dd></div>
      ))}
    </dl>

    <a class="buy" href={buyHref} rel="sponsored nofollow noopener" target="_blank">{buyLabel}</a>
    <p class="price-note">{priceNote}</p>
  </section>

  <slot />

</article>
</BaseLayout>
