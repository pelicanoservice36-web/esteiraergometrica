/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/video/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Rotas de saída para o marketplace: nunca indexar, nunca cachear.
# O robots.txt já bloqueia o crawl; isto é a segunda camada, para o caso de a
# URL ser descoberta por link externo. NÃO É CONFIRMADO que o Cloudflare Pages
# aplique _headers a respostas geradas por _redirects — conferir com
# `curl -I` no preview e, se não aplicar, o robots.txt segue sendo o controle.
/go/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# Página de vendas do e-book Marmita Leve em 21 Dias (produto separado do blog).
# Fora do índice para não misturar com o conteúdo de esteiras; fora do sitemap.
/marmita-leve/*
  X-Robots-Tag: noindex, follow

# VSL da página de vendas em HLS (o iPhone exige isso, já que o servidor não responde a pedidos por partes)
/marmita-leve/video/hls/*.m3u8
  Content-Type: application/vnd.apple.mpegurl

/marmita-leve/video/hls/*.ts
  Content-Type: video/mp2t
  Cache-Control: public, max-age=31536000, immutable
