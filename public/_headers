/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Rotas de saída para o marketplace: nunca indexar, nunca cachear.
# O robots.txt já bloqueia o crawl; isto é a segunda camada, para o caso de a
# URL ser descoberta por link externo. NÃO É CONFIRMADO que o Cloudflare Pages
# aplique _headers a respostas geradas por _redirects — conferir com
# `curl -I` no preview e, se não aplicar, o robots.txt segue sendo o controle.
/go/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
