# Google Ads (lidas no BUILD — configurar em Cloudflare Pages > Settings > Environment variables
# e fazer um novo deploy depois de mudar). Enquanto ficarem vazias ou com o placeholder, o código
# do Google Ads não é emitido no HTML (só o GA4 continua rodando).
#
# ID da conta: Google Ads > Metas > Conversões > (ação) > Configuração da tag > "AW-..."
PUBLIC_GADS_ID=AW-XXXXXXXXX
# send_to da conversão de clique no afiliado: "AW-<id>/<rótulo>"
PUBLIC_GADS_CONVERSION=AW-XXXXXXXXX/YYYYYYYYYY
